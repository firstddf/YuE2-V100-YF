# ── 编译产物:可重建,且 600+ MB ─────────────────────────────────
build/

# ── audio.cpp:第三方源码,不随仓库分发 ───────────────────────────
# 它是 Apache-2.0 的上游项目(github.com/0xShug0/audio.cpp),204 MB。
# 两种获取方式,都能保证版本正确:
#   * 普通用户:从 Release 的 *-audio.cpp-source-patched.zip 拿(已打好补丁)
#   * 自建者:scripts\fetch-audio-cpp.ps1(克隆固定提交 + 应用 patches\)
# 如果这里不排除,git 会把它当成嵌入式仓库(gitlink)提交 —— 别人 clone 到的是空目录。
audio.cpp/

# ── 模型权重:4.7 GB,且许可不允许随仓库分发(见 WEIGHTS.md)──────
models/

# ── 生成结果与实验产物:1 GB+,且都是本机可重跑的 ─────────────────
# 仓库里的 HTML 试听页会引用这里的 wav,克隆后需重跑脚本才会出现。
output/

# ── 日志:本机实测记录(build-fast.log 等被 README 引用,但不随仓库分发)
logs/

# ── HF 缓存 ──────────────────────────────────────────────────────
cache/

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── 编辑器 / 系统 ────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
